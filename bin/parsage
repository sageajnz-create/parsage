#!/usr/bin/env bash
# 🌿 PARSAGE Native Desktop Application
# Created with ❤️ by Sage & Antigravity

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )/.." >/dev/null 2>&1 && pwd )"

ELECTRON_BIN=""
for candidate in electron43 electron /usr/lib/electron*/electron; do
    if command -v "$candidate" &>/dev/null; then
        ELECTRON_BIN="$(command -v "$candidate")"
        break
    elif [ -x "$candidate" ]; then
        ELECTRON_BIN="$candidate"
        break
    fi
done

cmd_gui() {
    if [ -n "$ELECTRON_BIN" ]; then
        exec "$ELECTRON_BIN" "$SCRIPT_DIR/app/main.cjs" "$@"
    else
        # Fallback to standalone webview/app
        (python3 "$SCRIPT_DIR/host/uinput_service.py" &)
        (cd "$SCRIPT_DIR/server" && node dist/index.js &)
        sleep 1
        if command -v chromium &>/dev/null; then
            exec chromium --app="http://127.0.0.1:7777" --class=Parsage --user-data-dir="$HOME/.config/parsage/profile"
        elif command -v google-chrome-stable &>/dev/null; then
            exec google-chrome-stable --app="http://127.0.0.1:7777" --class=Parsage --user-data-dir="$HOME/.config/parsage/profile"
        else
            xdg-open "http://127.0.0.1:7777"
        fi
    fi
}

cmd_status() {
    python3 "$SCRIPT_DIR/host/pipewire_capture.py"
}

cmd_headless() {
    echo "Starting Parsage Headless Server..."
    python3 "$SCRIPT_DIR/host/uinput_service.py" &
    (cd "$SCRIPT_DIR/server" && node dist/index.js)
}

case "${1:-gui}" in
    gui|"")
        cmd_gui
        ;;
    host)
        cmd_gui
        ;;
    headless)
        cmd_headless
        ;;
    status)
        cmd_status
        ;;
    *)
        cmd_gui "$@"
        ;;
esac
