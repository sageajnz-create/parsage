#!/usr/bin/env bash
# 🌿 PARSAGE Native Desktop Client & Host Engine
# Created with ❤️ by Sage & Antigravity

set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )/.." >/dev/null 2>&1 && pwd )"
PORT="${PORT:-7777}"

RED='\033[0;31m'
GOLD='\033[0;33m'
GREEN='\033[0;32m'
TEAL='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

print_banner() {
    echo -e "${GREEN}============================================================${NC}"
    echo -e "${BOLD}${GREEN}  🌿 PARSAGE - Low Latency Linux Game & Desktop Streaming${NC}"
    echo -e "${GOLD}  \"One love, low latency, no limits.\"${NC}"
    echo -e "${RED}  Created with ❤️ by Sage & Antigravity${NC}"
    echo -e "${GREEN}============================================================${NC}"
}

ensure_service() {
    if ! ss -tulpn 2>/dev/null | grep -q ":${PORT}\b"; then
        echo -e "${GOLD}Starting Parsage background daemon...${NC}"
        python3 "$SCRIPT_DIR/host/uinput_service.py" &
        UINPUT_PID=$!
        (cd "$SCRIPT_DIR/server" && node dist/index.js) &
        SERVER_PID=$!
        sleep 1.2
    fi
}

open_app_window() {
    local TARGET_URL="${1:-http://localhost:${PORT}}"
    ensure_service

    # Check for standalone Chromium/Chrome app window mode
    if command -v chromium &>/dev/null; then
        exec chromium --app="$TARGET_URL" --class=Parsage --name=Parsage --user-data-dir="$HOME/.config/parsage/app_profile" --window-size=1280,820
    elif command -v google-chrome-stable &>/dev/null; then
        exec google-chrome-stable --app="$TARGET_URL" --class=Parsage --name=Parsage --user-data-dir="$HOME/.config/parsage/app_profile" --window-size=1280,820
    elif command -v brave-browser &>/dev/null; then
        exec brave-browser --app="$TARGET_URL" --class=Parsage --name=Parsage --user-data-dir="$HOME/.config/parsage/app_profile" --window-size=1280,820
    else
        xdg-open "$TARGET_URL" 2>/dev/null || sensible-browser "$TARGET_URL" 2>/dev/null
    fi
}

cmd_status() {
    print_banner
    python3 "$SCRIPT_DIR/host/pipewire_capture.py"
}

cmd_host() {
    open_app_window "http://localhost:${PORT}"
}

cmd_join() {
    ROOM_CODE="$1"
    if [ -z "$ROOM_CODE" ]; then
        echo -e "${RED}Error: Please provide a room code.${NC}"
        echo -e "Usage: parsage join PARSAGE-R4STA-777"
        exit 1
    fi
    open_app_window "http://localhost:${PORT}/?join=${ROOM_CODE}"
}

cmd_uinput_setup() {
    print_banner
    echo -e "${GOLD}Setting up /dev/uinput permissions for non-root gaming...${NC}"
    RULES_FILE="/etc/udev/rules.d/99-parsage-uinput.rules"
    if [ -w "/etc/udev/rules.d" ]; then
        echo 'KERNEL=="uinput", MODE="0660", GROUP="input", TAG+="uaccess"' > "$RULES_FILE"
        udevadm control --reload-rules && udevadm trigger
        echo -e "${GREEN}✅ udev rules installed successfully at ${RULES_FILE}!${NC}"
    else
        echo -e "${RED}Root privileges needed to write to /etc/udev/rules.d.${NC}"
        echo -e "Run: ${BOLD}sudo cp ${SCRIPT_DIR}/packaging/99-parsage-uinput.rules /etc/udev/rules.d/${NC}"
        echo -e "     ${BOLD}sudo udevadm control --reload-rules && sudo udevadm trigger${NC}"
    fi
}

cmd_help() {
    print_banner
    echo -e "Usage: parsage <command> [arguments]\n"
    echo -e "Commands:"
    echo -e "  ${BOLD}${GREEN}parsage${NC}          Launch Parsage Standalone Desktop App"
    echo -e "  ${BOLD}${GREEN}host${NC}             Start host stream and launch desktop app"
    echo -e "  ${BOLD}${GOLD}join <CODE>${NC}      Join a live Parsage session in standalone window"
    echo -e "  ${BOLD}${TEAL}status${NC}           Display system info, AMD VA-API encoder, PipeWire, and uinput state"
    echo -e "  ${BOLD}${RED}uinput-setup${NC}     Configure udev rules so gamepads work seamlessly without root"
    echo -e "  ${BOLD}help${NC}             Show this help message\n"
}

case "${1:-default}" in
    default|"")
        open_app_window "http://localhost:${PORT}"
        ;;
    host)
        cmd_host
        ;;
    join)
        cmd_join "$2"
        ;;
    status)
        cmd_status
        ;;
    uinput-setup)
        cmd_uinput_setup
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        cmd_help
        ;;
esac
